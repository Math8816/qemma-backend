# ═══════════════════════════════════════════════
#  Qemma Backend — .gitignore
# ═══════════════════════════════════════════════

# ─── Logs ───
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Dependencies ───
node_modules/

# ─── Build ───
dist/
dist-ssr/
build/
*.local

# ─── Environment Variables (حساسة!) ───
.env
.env.local
.env.production
.env.development
.env.test
*.env

# ─── Storage (ملفات المستخدم) ───
storage/
uploads/
backups/

# ─── Cypress (نواتج الاختبار) ───
cypress/videos/
cypress/screenshots/
cypress/downloads/

# ─── Editor ───
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ─── OS ───
.DS_Store
Thumbs.db
desktop.ini

# ─── Misc ───
*.suo
*.ntvs*
*.njsproj
*.sln
*.log

# ─── Database dumps ───
*.sql
*.dump
*.sqlite

# ─── Temporary ───
tmp/
temp/
.cache/