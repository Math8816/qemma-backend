# ═══════════════════════════════════════════════
#  Qemma Backend — Environment
# ═══════════════════════════════════════════════

# ─── عام ───
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── PostgreSQL ───
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Admin123
DB_NAME=qemma_services

# ─── JWT ───
JWT_SECRET=qemma-local-dev-secret-change-me
JWT_EXPIRES_IN=1h

# ─── Storage ───
STORAGE_PATH=./storage

# ═══════════════════════════════════════════════
